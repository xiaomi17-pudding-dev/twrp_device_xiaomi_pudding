#
# pudding fix22AAR:
# - keep the real persist mount on /mnt/vendor/persist, matching stock/vendor expectations
# - expose /persist only as an alias, so TWRP stops fighting a second mount
# - export slot props into /odm/etc build prop files for installer-side AK3 shell logic

import /init.recovery.wifi.rc

on init
    start vendor.boot-qti
    setprop prepdecrypt.setpatch true

on early-fs
    write /proc/sys/walt/sched_lib_name "recovery,magiskboot,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion
    mkdir /mnt/vendor 0775 shell system
    mkdir /mnt/vendor/persist 0771 root system
    install_keyring

on post-fs
    start odm.ak3-slot-compat
    start odm.persist-alias-setup
    start odm.variant-script

on boot
    setprop sys.usb.config adb

on property:twrp.modules.loaded=true
    mkdir /firmware
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    wait /sys/kernel/boot_adsp/ssr
    write /sys/kernel/boot_adsp/ssr 1
    wait /sys/class/power_supply/battery
    start vendor.health-default
    umount /vendor
    symlink /firmware /vendor/firmware_mnt

on property:ro.crypto.state=encrypted && property:ro.boot.dynamic_partitions=true
    start odm.decrypt-gate

on property:twrp.variant.files_copied=1
    start odm.vibratorfeature-service
    start odm.touch_report
    start odm.weaver-service
    setprop twrp.pudding.fix22zr.strongbox_enabled 1
    start odm.secure-element-ta-setup

on property:twrp.pudding.fix22zr.ready=1
    stop vendor.qwesd
    stop vendor.minkdaemon
    stop vendor.secure_element
    stop vendor.keymint-strongbox
    stop odm.se_omapi
    rm /vendor/firmware_mnt
    symlink /tmp/secure_element_fwroot /vendor/firmware_mnt
    setprop twrp.pudding.fix22zr.bind_done 1
    start vendor.secure_element
    start vendor.keymint-strongbox
    start odm.se_omapi
    start odm.secure-element-followup

service odm.secure-element-ta-setup /system/bin/secure-element-ta-setup.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

service odm.secure-element-followup /system/bin/secure-element-followup.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

service odm.persist-alias-setup /system/bin/persist-alias-setup.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

service odm.ak3-slot-compat /system/bin/ak3-slot-compat.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

service odm.decrypt-gate /system/bin/decrypt-gate.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0
