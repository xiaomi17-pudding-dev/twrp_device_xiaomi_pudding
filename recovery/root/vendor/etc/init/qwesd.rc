# pudding fix22ZG: stock qwesd service, started after TA bind.

service vendor.qwesd /vendor/bin/qwesd
    class late_start
    user system
    group system inet
    disabled
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/odm/lib64:/system/lib64:/sbin
    seclabel u:r:recovery:s0
